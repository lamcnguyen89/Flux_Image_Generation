HUGGINGFACE_TOKEN="Huggingface_Token_Goes_Here"
# Cache location is optional. You can set where you want to download these large models
CACHE_LOCATION=/home/malneyugnfl/SoftwareDev/Image_Generator/Models/huggingface

# Local Wi-Fi address when using bash scripts/start.sh.
# Name only: no http://, .local, or :port is needed.
# Requires avahi-utils and a running avahi-daemon on the server.
# Leave HOSTNAME empty to disable publishing a .local alias.
IMAGE_GENERATOR_HOSTNAME=midnightgen
IMAGE_GENERATOR_PORT=5000
# Listen on all network interfaces so other Wi-Fi devices can connect.
IMAGE_GENERATOR_HOST=0.0.0.0

# Optional password for all web pages, APIs, uploads, and downloads.
# Set a nonempty value and restart the service to enable the sign-in page.
# Use quotes to preserve spaces, #, and other dotenv special characters.
IMAGE_GENERATOR_ACCESS_PASSWORD=""
